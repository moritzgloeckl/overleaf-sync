# Local configuration for the overleaf.com smoke tests (pytest -m smoke).
# Copy to .env (git-ignored) and fill in. Use a dedicated test account, never commit real values.
# No password here: Overleaf's login has a captcha, so the tests use a session instead.

# Option 1: the `overleaf_session2` cookie value from a browser logged in to the smoke account
# (DevTools > Application/Storage > Cookies > https://www.overleaf.com)
OLSYNC_SMOKE_COOKIE=

# Option 2: an auth file created with `ols login --path ~/.config/olsync-smoke/.olauth`
# OLSYNC_SMOKE_AUTH=~/.config/olsync-smoke/.olauth

# The smoke project's id, from its URL (overleaf.com/project/<id>). Its name must start with "olsync-smoke".
OLSYNC_SMOKE_PROJECT_ID=
